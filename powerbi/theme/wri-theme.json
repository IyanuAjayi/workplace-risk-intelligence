        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#000000"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#F7F5EC"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#000000"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F5EC"
              }
            },
            "outline": "None",
            "fontFamily": "Segoe UI",
