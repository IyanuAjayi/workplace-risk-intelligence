// Workplace Risk Intelligence: every measure in the semantic model, grouped by the page that uses it.
// Generated by powerbi/tools/measures.py from the same list as powerbi/model/measures.tmdl; edit the script, not this file.
// Pricing measures are simulated: never label them as actual premiums, claims or loss ratios.

// ---- Base ----

// format: #,0
Sites[Sites scored] = SUM ( Sites[Site count] )

// format: #,0
Sites[Sites crossing next year] = SUM ( Sites[Crossing sites] )

// format: 0.0%
Sites[Base rate] = DIVIDE ( [Sites crossing next year], [Sites scored] )

// format: 0.00
Sites[Average site DART rate] = DIVIDE ( SUM ( Sites[DART rate sum] ), [Sites scored] )

// format: text or general
Sites[Test year label] = SELECTEDVALUE ( TestYears[Test year], "2023 + 2024" )

// ---- Executive Intelligence ----

// format: #,0
Sites[Band 5 sites] = CALCULATE ( [Sites scored], Sites[Risk band] = "5 highest" )

// format: #,0
Sites[Band 5 crossing sites] = CALCULATE ( [Sites crossing next year], Sites[Risk band] = "5 highest" )

// format: #,0
Sites[All crossing sites] = CALCULATE ( [Sites crossing next year], REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ), REMOVEFILTERS ( Bands ) )

// format: #,0
Sites[All sites scored] = CALCULATE ( [Sites scored], REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ), REMOVEFILTERS ( Bands ) )

// format: 0.0%
Sites[Top band capture] = DIVIDE ( [Band 5 crossing sites], [All crossing sites] )

// format: 0.0%
Sites[Capture remainder] = 1 - [Top band capture]

// format: 0.0%
Sites[Top band hit rate] = DIVIDE ( [Band 5 crossing sites], [Band 5 sites] )

// format: 0.0%
Sites[Share of sites in top band] = DIVIDE ( [Band 5 sites], [All sites scored] )

// format: 0.0%
Sites[All sites rate] = DIVIDE ( [All crossing sites], [All sites scored] )

// format: 0%
Sites[Random fifth] = 0.2

// format: text or general
Sites[Capture base line] = FORMAT ( [Band 5 crossing sites], "#,0" ) & " of " & FORMAT ( [All crossing sites], "#,0" ) & " · 2023 + 2024"

// format: text or general
Sites[Hit rate base line] = FORMAT ( [Band 5 crossing sites], "#,0" ) & " of " & FORMAT ( [Band 5 sites], "#,0" ) & " · 2023 + 2024"

// format: 0.0%
Sites[Crossing rate 2023] = CALCULATE ( [Base rate], Sites[Score year] = 2023 )

// format: 0.0%
Sites[Crossing rate 2024] = CALCULATE ( [Base rate], Sites[Score year] = 2024 )

// format: 0.000
Models[AUC 2023] = CALCULATE ( AVERAGE ( 'Models'[AUC] ), 'Models'[Test year] = 2023 )

// format: 0.000
Models[AUC 2024] = CALCULATE ( AVERAGE ( 'Models'[AUC] ), 'Models'[Test year] = 2024 )

// format: text or general
Models[AUC 2023 words] =
    VAR m = SELECTEDVALUE ( 'Models'[Model] )
    RETURN IF ( m <> "Last year's rate", "about " & FORMAT ( ROUND ( [AUC 2023] * 10, 0 ), "0" ) & " in 10" )

// format: text or general
PricingSummary[Wrong band A to B 2023 central] =
    VAR f = FILTER ( ALL ( PricingSummary ), PricingSummary[Score year] = 2023 && PricingSummary[Claim-cost scenario] = "central" )
    RETURN FORMAT ( MAXX ( f, PricingSummary[Misallocated share A] ), "0.0%" ) & UNICHAR ( 8201 ) & "→" & UNICHAR ( 8201 )
        & FORMAT ( MAXX ( f, PricingSummary[Misallocated share B] ), "0.0%" )

// ---- Risk Landscape ----

// format: #,0
Sites[Portfolio site-years] = CALCULATE ( [Sites scored], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ) )

// format: #,0
Sites[Portfolio crossing sites] = CALCULATE ( [Sites crossing next year], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ) )

// format: 0.0%
Sites[Portfolio crossing rate] = DIVIDE ( [Portfolio crossing sites], [Portfolio site-years] )

// format: text or general
Sites[Portfolio base line] = FORMAT ( [Portfolio crossing sites], "#,0" ) & " of " & FORMAT ( [Portfolio site-years], "#,0" ) & " · " & [Test year label]

// format: 0.00
Sites[Portfolio DART rate] = CALCULATE ( [Average site DART rate], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ) )

// format: #,0
Sites[Band 5 site-years] = CALCULATE ( [Sites scored], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Band order] ), Sites[Risk band] = "5 highest" )

// format: 0.0%
Sites[Band 5 share] = DIVIDE ( [Band 5 site-years], [Portfolio site-years] )

// format: text or general
Sites[Band 5 base line] = FORMAT ( [Band 5 site-years], "#,0" ) & " band 5 site-years · " & [Test year label]

// format: text or general
Sites[Band 5 crossing range] =
    VAR t =
        FILTER (
            ADDCOLUMNS (
                VALUES ( Sites[Sector] ),
                "@n", CALCULATE ( [Sites scored], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Band order] ), Sites[Risk band] = "5 highest" ),
                "@r", CALCULATE ( [Base rate], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Band order] ), Sites[Risk band] = "5 highest" )
            ),
            [@n] >= 100
        )
    VAR lo = MINX ( t, [@r] )
    VAR hi = MAXX ( t, [@r] )
    RETURN
        IF (
            NOT ISEMPTY ( t ),
            IF ( ROUND ( lo, 3 ) = ROUND ( hi, 3 ), FORMAT ( lo, "0.0%" ), FORMAT ( lo, "0.0%" ) & " to " & FORMAT ( hi, "0.0%" ) )
        )

// format: 0
Sites[Map band order] = COALESCE ( SELECTEDVALUE ( Bands[Band order] ), 5 )

// format: 0.0%
Sites[Map share] =
    VAR b = [Map band order]
    RETURN DIVIDE ( CALCULATE ( [Sites scored], REMOVEFILTERS ( Bands ), REMOVEFILTERS ( Sites[Risk band] ), Sites[Band order] = b ), [Portfolio site-years] )

// format: text or general
Sites[Map tile label] = IF ( [Portfolio site-years] >= 500, SELECTEDVALUE ( StateGrid[State] ), " " )

// format: text or general
Sites[Map tile colour] =
    VAR s = [Map share]
    RETURN IF ( [Portfolio site-years] >= 500, SWITCH ( TRUE (), s >= 0.25, "#C98369", s >= 0.15, "#D9B9A7", "#EADFD2" ) )

// format: text or general
Sites[State name label] = SELECTEDVALUE ( StateGrid[State name] )

// format: ;;;
Sites[Map hover x] = SELECTEDVALUE ( StateGrid[Grid column] )

// format: ;;;
Sites[Map hover y] = 7 - SELECTEDVALUE ( StateGrid[Grid row] )

// format: text or general
Sites[Map title] = "Band " & [Map band order] & " share by state"

// format: text or general
Sites[Map legend title] = "Share of site-years, " & [Test year label]

// format: text or general
Sites[Map share label] = IF ( [Portfolio site-years] < 500, "Too few sites", FORMAT ( [Map share], "0.0%" ) & " in band " & [Map band order] )

// format: text or general
Sites[State site-years] = IF ( [Portfolio site-years] < 500, "Under 500", FORMAT ( [Portfolio site-years], "#,0" ) ) & " site-years · " & [Test year label]

// format: text or general
Sites[Site-years label] = FORMAT ( [Portfolio site-years], "#,0" )

// format: text or general
Sites[Portfolio note] = [Test year label] & " · DART: serious-injury rate per 100 full-time workers"

// format: #,0
Sites[Cell site-years] = CALCULATE ( [Sites scored], REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ) )

// format: 0.0%;"Too few sites"
Sites[Cell crossing rate] =
    VAR n = [Cell site-years]
    RETURN IF ( n > 0, IF ( n < 100, -1, CALCULATE ( [Base rate], REMOVEFILTERS ( Sites[Risk band], Sites[Band order] ) ) ) )

// format: text or general
Sites[Band table note] = "Crossed the line next year, " & [Test year label] & " · line: each industry's worst-20% DART rate this year · data bars 0 to 100% · too few sites: under 100 site-years"

// format: 0.0%;"Too few sites"
Sites[Crossed Manufacturing] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Manufacturing" ) )

// format: 0.0%;"Too few sites"
Sites[Crossed Construction] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Construction" ) )

// format: 0.0%;"Too few sites"
Sites[Crossed Transport and warehousing] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Transport and warehousing" ) )

// format: 0.0%;"Too few sites"
Sites[Crossed Wholesale] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Wholesale" ) )

// format: 0.0%;"Too few sites"
Sites[Crossed Utilities] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Utilities" ) )

// format: 0.0%;"Too few sites"
Sites[Crossed Agriculture] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Agriculture" ) )

// format: 0.0%;"Too few sites"
Sites[Crossed Mining, oil and gas] = CALCULATE ( [Cell crossing rate], KEEPFILTERS ( Sites[Sector] = "Mining, oil and gas" ) )

// ---- Model Trust ----

// format: text or general
Models[Picked model] = SELECTEDVALUE ( ModelPicker[Model], "Scorecard" )

// format: 0
Models[Picked test year] = SELECTEDVALUE ( TestYearPicker[Test year], 2023 )

// format: 0.00
Models[Picked AUC] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    RETURN CALCULATE ( AVERAGE ( 'Models'[AUC] ), REMOVEFILTERS ( 'Models' ), 'Models'[Model] = m, 'Models'[Test year] = y )

// format: text or general
Models[Picked AUC base] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    VAR lo = CALCULATE ( AVERAGE ( 'Models'[AUC low] ), REMOVEFILTERS ( 'Models' ), 'Models'[Model] = m, 'Models'[Test year] = y )
    VAR hi = CALCULATE ( AVERAGE ( 'Models'[AUC high] ), REMOVEFILTERS ( 'Models' ), 'Models'[Model] = m, 'Models'[Test year] = y )
    RETURN m & ", " & y & " · 95% CI " & FORMAT ( lo, "0.000" ) & " to " & FORMAT ( hi, "0.000" )

// format: 0.00
Models[Picked Gini] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    RETURN CALCULATE ( AVERAGE ( 'Models'[Gini] ), REMOVEFILTERS ( 'Models' ), 'Models'[Model] = m, 'Models'[Test year] = y )

// format: text or general
Models[Picked test pairs] =
    VAR y = [Picked test year]
    RETURN FORMAT ( CALCULATE ( MAX ( 'Models'[Sites] ), REMOVEFILTERS ( 'Models' ), 'Models'[Test year] = y ), "#,0" ) & " test pairs · " & y

// format: text or general
Models[Picked model and year] = [Picked model] & ", " & [Picked test year]

// format: text or general
Models[ROC AUC label] = "AUC " & FORMAT ( [Picked AUC], "0.00" )

// format: 0.000
Models[Gini 2023] = CALCULATE ( AVERAGE ( 'Models'[Gini] ), 'Models'[Test year] = 2023 )

// format: 0.000
Models[Gini 2024] = CALCULATE ( AVERAGE ( 'Models'[Gini] ), 'Models'[Test year] = 2024 )

// format: 0.0%
Models[Capture top 20% 2023] = CALCULATE ( AVERAGE ( 'Models'[Capture top 20%] ), 'Models'[Test year] = 2023 )

// format: 0.0%
Models[Capture top 20% 2024] = CALCULATE ( AVERAGE ( 'Models'[Capture top 20%] ), 'Models'[Test year] = 2024 )

// format: 0.0%
Models[Precision top 20% 2023] = CALCULATE ( AVERAGE ( 'Models'[Precision top 20%] ), 'Models'[Test year] = 2023 )

// format: 0.0%
Models[Precision top 20% 2024] = CALCULATE ( AVERAGE ( 'Models'[Precision top 20%] ), 'Models'[Test year] = 2024 )

// format: text or general
Models[Model row fill] = IF ( SELECTEDVALUE ( 'Models'[Model] ) = [Picked model], "#E3DECF", "#F7F5EC" )

// format: 0%
ROC[ROC true positive rate] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    RETURN CALCULATE ( MAX ( ROC[True positive rate] ), ROC[Model] = m, ROC[Test year] = y )

// format: 0%
ROC[Coin toss] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    RETURN CALCULATE ( MAX ( ROC[False positive rate] ), ROC[Model] = m, ROC[Test year] = y )

// format: 0.0%
Calibration[Share that crossed] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    RETURN CALCULATE ( AVERAGE ( Calibration[Observed share] ), Calibration[Model] = m, Calibration[Test year] = y )

// format: 0.0%
Calibration[Predicted] =
    VAR m = [Picked model]
    VAR y = [Picked test year]
    RETURN CALCULATE ( AVERAGE ( Calibration[Predicted share] ), Calibration[Model] = m, Calibration[Test year] = y )

// format: text or general
Calibration[Calibration note] = IF ( [Picked model] = "Last year's rate", "Last year's rate is a rank, not a probability, so it has no calibration.", " " )

// format: 0.000
Robustness[Robustness AUC 2023] = SUM ( Robustness[AUC 2023] )

// format: 0.000
Drivers[Driver AUC drop] = SUM ( Drivers[AUC drop] )

// ---- Pricing Lab ----

// format: text or general
PricingSummary[Selected scenario] = SELECTEDVALUE ( ClaimCostScenarios[Scenario key], "central" )

// format: 0
PricingSummary[Selected score year] = SELECTEDVALUE ( ScoreYears[Score year], 2023 )

// format: text or general
PricingSummary[Pricing scenario label] = FORMAT ( [Selected score year], "0" ) & " " & [Selected scenario]

// format: #,0
PricingSummary[Priced sites] =
    VAR y = [Selected score year]
    RETURN CALCULATE ( SUM ( PricingBands[Sites] ), REMOVEFILTERS ( PricingBands ), PricingBands[Claim-cost scenario] = "central", PricingBands[Score year] = y )

// format: text or general
PricingSummary[Pricing base line] = [Pricing scenario label] & " · " & FORMAT ( [Priced sites], "#,0" ) & " sites"

// format: text or general
PricingSummary[Pricing year base line] = FORMAT ( [Selected score year], "0" ) & " · " & FORMAT ( [Priced sites], "#,0" ) & " sites"

// format: 0.0%
PricingSummary[Wrong band share A] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingSummary[Misallocated share A] ), PricingSummary[Claim-cost scenario] = s, PricingSummary[Score year] = y )

// format: 0.0%
PricingSummary[Wrong band share B] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingSummary[Misallocated share B] ), PricingSummary[Claim-cost scenario] = s, PricingSummary[Score year] = y )

// format: text or general
PricingSummary[Wrong band A to B] = FORMAT ( [Wrong band share A], "0.0%" ) & UNICHAR ( 8201 ) & "→" & UNICHAR ( 8201 ) & FORMAT ( [Wrong band share B], "0.0%" )

// format: 0.00
PricingSummary[Overall loss ratio A] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingSummary[Overall ratio A] ), PricingSummary[Claim-cost scenario] = s, PricingSummary[Score year] = y )

// format: 0.00
PricingSummary[Overall loss ratio B] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingSummary[Overall ratio B] ), PricingSummary[Claim-cost scenario] = s, PricingSummary[Score year] = y )

// format: text or general
PricingSummary[Overall ratio A to B] = FORMAT ( [Overall loss ratio A], "0.00" ) & UNICHAR ( 8201 ) & "→" & UNICHAR ( 8201 ) & FORMAT ( [Overall loss ratio B], "0.00" )

// format: text or general
PricingSummary[Scenario premium] =
    VAR y = [Selected score year]
    RETURN FORMAT ( CALCULATE ( SUM ( PricingSummary[Total premium] ), PricingSummary[Score year] = y ) / 1E9, "$#,0.00" ) & "bn"

// format: text or general
PricingSummary[Scenario simulated loss] =
    VAR y = [Selected score year]
    RETURN FORMAT ( CALCULATE ( SUM ( PricingSummary[Simulated loss] ), PricingSummary[Score year] = y ) / 1E9, "$#,0.00" ) & "bn"

// format: 0.00
PricingSummary[Scenario loss ratio] =
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingSummary[Overall ratio A] ), PricingSummary[Score year] = y )

// format: text or general
PricingSummary[Scenario wrong band A to B] =
    VAR y = [Selected score year]
    RETURN FORMAT ( CALCULATE ( AVERAGE ( PricingSummary[Misallocated share A] ), PricingSummary[Score year] = y ), "0.0%" ) & " → "
        & FORMAT ( CALCULATE ( AVERAGE ( PricingSummary[Misallocated share B] ), PricingSummary[Score year] = y ), "0.0%" )

// format: text or general
PricingSummary[Scenario band spread A to B] =
    VAR y = [Selected score year]
    RETURN FORMAT ( CALCULATE ( AVERAGE ( PricingSummary[Band spread A] ), PricingSummary[Score year] = y ), "0.0" ) & "x → "
        & FORMAT ( CALCULATE ( AVERAGE ( PricingSummary[Band spread B] ), PricingSummary[Score year] = y ), "0.0" ) & "x"

// format: text or general
PricingSummary[Scenario row fill] = IF ( SELECTEDVALUE ( PricingSummary[Claim-cost scenario] ) = [Selected scenario], "#E3DECF", "#F7F5EC" )

// format: 0.00
PricingBands[Band loss ratio A] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingBands[Loss ratio A] ), PricingBands[Claim-cost scenario] = s, PricingBands[Score year] = y )

// format: 0.00
PricingBands[Band loss ratio B] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingBands[Loss ratio B] ), PricingBands[Claim-cost scenario] = s, PricingBands[Score year] = y )

// format: 0.00
PricingBands[Band loss ratio low] = MIN ( [Band loss ratio A], [Band loss ratio B] )

// format: 0.00
PricingBands[Band loss ratio high] = MAX ( [Band loss ratio A], [Band loss ratio B] )

// format: +0.0%;−0.0%;0.0%
PricingBands[Band premium change] =
    VAR s = [Selected scenario]
    VAR y = [Selected score year]
    RETURN CALCULATE ( AVERAGE ( PricingBands[Premium change] ), PricingBands[Claim-cost scenario] = s, PricingBands[Score year] = y )
